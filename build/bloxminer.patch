@@ -198,6 +198,18 @@
 pthread_mutex_t applog_lock;
 pthread_mutex_t stats_lock;
 double thr_hashrates[MAX_GPUS] = { 0 };
+/* hiveos-ccminer-verus: per-thread observability (guarded by stats_lock) */
+time_t thr_lastwork[MAX_GPUS] = { 0 };   /* monotonic time (s) a scan batch last completed or was interrupted */
+time_t hcv_mono_now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec; }
+static double hcv_mono_d(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec + 1e-9 * t.tv_nsec; }
+double thr_lastdur[MAX_GPUS] = { 0 };    /* duration (s) of that batch; batches last up to minutes */
+double thr_ratek[MAX_GPUS] = { 0 };      /* H/s of that batch, for the API only (never feeds batch sizing) */
+double thr_maxdur[MAX_GPUS] = { 0 };     /* longest batch seen (s); a short job-interrupted batch must not shrink the overdue limit */
+int thr_cpu[MAX_GPUS];                   /* cpu the thread is bound to, -1 if unbound */
+#if defined(__linux__) && !defined(__ANDROID__)
+static cpu_set_t allowed_cpus;           /* process affinity snapshot taken before workers start */
+static int allowed_cpu_count = 0;
+#endif
 uint64_t global_hashrate = 0;
 double   stratum_diff = 0.0;
 double   net_diff = 0;
@@ -537,12 +549,29 @@
 static void affine_to_cpu(int id) {
 	cpu_set_t set;
 	CPU_ZERO(&set);
-	CPU_SET(id, &set);
-	// thread only
 #if !(defined(__ANDROID__) || (__ANDROID_API__ > 23))
-		pthread_setaffinity_np(thr_info[id].pth, sizeof(&set), &set);
+	if (getenv("HCV_NO_AFFINITY")) { /* let the scheduler place threads (Oink 3.8.3a behaviour) */
+		pthread_mutex_lock(&stats_lock); thr_cpu[id] = -1; pthread_mutex_unlock(&stats_lock);
+		return;
+	}
+	/* bind thread id to the id-th cpu the process is allowed to run on (cpuset/taskset aware) */
+	int cpu = -1, seen = 0;
+	for (int c = 0; c < CPU_SETSIZE && allowed_cpu_count > 0; c++) {
+		if (!CPU_ISSET(c, &allowed_cpus)) continue;
+		if (seen++ == id) { cpu = c; break; }
+	}
+	if (cpu < 0) {
+		applog(LOG_WARNING, "CPU T%d: no allowed cpu left, running unbound", id);
+		pthread_mutex_lock(&stats_lock); thr_cpu[id] = -1; pthread_mutex_unlock(&stats_lock);
+		return;
+	}
+	CPU_SET(cpu, &set);
+	int err = pthread_setaffinity_np(pthread_self(), sizeof(set), &set);
+	if (err) applog(LOG_WARNING, "CPU T%d: affinity to cpu %d failed (%d), running unbound", id, cpu, err);
+	pthread_mutex_lock(&stats_lock); thr_cpu[id] = err ? -1 : cpu; pthread_mutex_unlock(&stats_lock);
 #else
-		sched_setaffinity(0, sizeof(&set), &set);
+	CPU_SET(id, &set);
+	sched_setaffinity(0, sizeof(set), &set);
 #endif
 }
