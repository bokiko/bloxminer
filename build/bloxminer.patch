+	errno = 0;
+	v = arg ? strtod(arg, &end) : 0;
+	if (!arg || end == arg || *end != '\0' || errno == ERANGE || !isfinite(v)) {
+		applog(LOG_ERR, "invalid number '%s'", arg ? arg : "");
