+bool blox_is_hex(const char *s, size_t minlen, size_t maxlen)
+{
+	if (!s) return false;
+	size_t n = strnlen(s, maxlen + 1);
+	if (n < minlen || n > maxlen || (n & 1)) return false;
+	for (size_t i = 0; i < n; i++)
+		if (!isxdigit((unsigned char)s[i])) return false;
