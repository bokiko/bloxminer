+extern int thr_cpu[];
+extern pthread_mutex_t stats_lock;
+/* a thread is overdue when its current batch has run longer than twice its longest batch so far + 30 s
+ * (full batches last ~60-180 s; batches cut short by a new pool job can be ~1 s and must not shrink the limit) */
+static inline long thr_stale_limit(int i) {
+	long l = (long) (2.0 * thr_maxdur[i]) + 30;
+	if (l < 300) l = 300;          /* floor: a short first batch must not make a healthy long batch look overdue */
+	if (l > 600) l = 600;          /* cap: a stall is always reported within 10 min of the last work */
+	return l;
+}
