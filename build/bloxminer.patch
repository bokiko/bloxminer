+		n = snprintf(buffer + len, MYBUFSIZ - len, "ROW=%d;PKG=%d;CORE=%d;CPUS=%s;KHS=%.2f;TEMP=%s;SRC=%s|",
+			k, r->pkg, r->core, cpus, r->khs, temp, src);
+		if (n < 0 || (size_t) n >= MYBUFSIZ - len) { buffer[len] = '\0'; break; }   /* truncated: ROWS tells the reader */
+		len += n;
+	}
+	free(s);
+	return buffer;
+}
