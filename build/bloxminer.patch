+/* bloxminer: strict numeric option parsing (atoi/atof silently accepted garbage and overflowed) */
+static int blox_atoi(const char *arg)
+{
+	char *end; long v;
+	errno = 0;
+	v = arg ? strtol(arg, &end, 10) : 0;
+	if (!arg || end == arg || *end != '\0' || errno == ERANGE || v < INT_MIN || v > INT_MAX) {
+		applog(LOG_ERR, "invalid number '%s'", arg ? arg : "");
+		proper_exit(EXIT_CODE_USAGE);
+	}
+	return (int) v;
