+static char *getcores(char *params)
+{
+	struct blox_snap *s = (struct blox_snap *) malloc(sizeof(struct blox_snap));
+	size_t len = 0;
+	*buffer = '\0';
+	if (!s) return buffer;
+	if (!blox_snapshot(s)) { free(s); snprintf(buffer, MYBUFSIZ, "GEN=0;ROWS=0|"); return buffer; }
+	int n = snprintf(buffer, MYBUFSIZ, "GEN=%llu;AGE=%.1f;ROWS=%d;THREADS=%d/%d;PERCORE=%d;STALL=%d|",
+		(unsigned long long) s->gen, blox_mono() - s->mono, s->rows, s->threads_covered, s->threads_cfg,
+		s->percore ? 1 : 0, s->stall ? 1 : 0);
+	if (n < 0 || n >= MYBUFSIZ) { buffer[0] = '\0'; free(s); return buffer; }
+	len = n;
