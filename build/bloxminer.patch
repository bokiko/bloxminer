diff -ruN a/blox.h b/blox.h
--- a/blox.h	1970-01-01 03:00:00
+++ b/blox.h	2026-09-27 14:26:19
@@ -0,0 +1,113 @@
+/* BloxMiner additions: CPU topology, sensors, per-core stats snapshot, terminal dashboard, log file.
+ * GPL-3.0 (part of a ccminer derivative). Nothing here touches hashing. */
+#pragma once
+
+#include <stdio.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <signal.h>
+
+#define BLOX_MAX_CPUS 1024
+#define BLOX_MAX_PKGS 8
+#define BLOX_MAX_ROWS 140          /* = MAX_GPUS: one row per thread at most */
+#define BLOX_ROW_CPUS 8
+#define BLOX_RAPL_MAX_W 2000.0      /* plausibility bound for one CPU package (W) */
+
+/* ---- topology and sensors (blox_sys.cpp) ---- */
+enum blox_tsrc { BLOX_T_NONE = 0, BLOX_T_PKG, BLOX_T_CCD, BLOX_T_CORE };
+
+struct blox_cpu {
+	bool present;
+	int pkg, core, l3;             /* -1 when unknown */
+	char temp_path[160];           /* per-CPU temperature input (CCD or core), empty = use package temp */
+	int  temp_src;                 /* BLOX_T_CCD / BLOX_T_CORE / BLOX_T_NONE */
+};
+
+struct blox_topo {
+	int ncpu;                      /* highest present cpu index + 1 */
+	struct blox_cpu cpu[BLOX_MAX_CPUS];
+	int npkg, pkg_id[BLOX_MAX_PKGS];
+	char pkg_temp_path[BLOX_MAX_PKGS][160];
+	char vendor[16], model_name[80];
+	int family, model;
+	int cores, threads;            /* physical cores / logical cpus present */
+	int nl3, ntccd;
+	int ccd_mode;                  /* 1 = per-CCD temps in use */
+	char ccd_reason[128];          /* why per-CCD temps are on/off (shown by --sensors) */
+};
+
+struct blox_rapl {
+	int n;
+	char path[BLOX_MAX_PKGS][160];
+	int pkg[BLOX_MAX_PKGS];
+	uint64_t range[BLOX_MAX_PKGS], last_e[BLOX_MAX_PKGS];
+	double last_t[BLOX_MAX_PKGS];
+	bool have_last[BLOX_MAX_PKGS];
+	bool usable;                   /* every topology package has exactly one readable package domain */
+	char reason[128];
+};
+
+const char *blox_sysfs(const char *path, char *out, size_t outsz);   /* prefixes $BLOX_SYSFS_ROOT (tests) */
+void blox_topo_init(struct blox_topo *t, int ccd_opt);              /* ccd_opt: -1 auto, 0 off, 1 forced */
+int  blox_read_temp(const char *path);                              /* degrees C, -1 when unreadable */
+int  blox_pkg_temp(const struct blox_topo *t);                      /* hottest package, -1 when none */
+int  blox_cpu_temp(const struct blox_topo *t, int cpu, int *src);   /* falls back to package temp */
+void blox_rapl_init(struct blox_rapl *r, const struct blox_topo *t);
+double blox_rapl_watts(struct blox_rapl *r, double now);            /* total W, -1 when not valid */
+void blox_sensors_dump(FILE *f, int ccd_opt);                       /* --sensors */
+
+/* A thread is overdue when its current batch has run longer than twice its longest batch so far + 30 s,
+ * clamped to 300..600 s (2.0.0 rule, shared by the API and the sampler). */
+static inline long blox_stale_limit(double maxdur)
+{
+	long l = (long) (2.0 * maxdur) + 30;
+	if (l < 300) l = 300;
+	if (l > 600) l = 600;
+	return l;
+}
+
+/* ---- per-core snapshot + service thread (blox_stats.cpp) ---- */
+struct blox_row {
+	int pkg, core;                 /* -1/-1 for a per-thread row */
+	int ncpu, cpus[BLOX_ROW_CPUS];
+	double khs;                    /* sum of fresh thread rates in kH/s */
+	int temp, temp_src;            /* -1 when none */
+	bool pending;                  /* no thread of this row has finished a batch yet (startup) */
+};
+
+struct blox_snap {
+	uint64_t gen;
+	double mono;                   /* monotonic time of the sample */
+	int rows;
+	bool percore;                  /* rows are physical cores (else one row per thread) */
+	int threads_cfg, threads_covered;
+	bool stall;
+	double fresh_khs;
+	double power_w;                /* -1 when unavailable */
+	int pkg_temp;                  /* -1 when unavailable */
+	struct blox_row row[BLOX_MAX_ROWS];
+};
+
+extern int blox_ccd_opt;               /* --ccd-temp-map auto|0|1 */
+extern int blox_stats_interval;        /* --stats-interval seconds (periodic table) */
+extern bool blox_no_dashboard;         /* --no-dashboard */
+extern bool blox_thread_log;           /* --thread-log */
+extern struct blox_topo blox_topology;
+
+void blox_prepare(void);               /* topology + RAPL discovery */
+bool blox_start(void);                 /* service thread: sampler, dashboard, signal watcher */
+bool blox_snapshot(struct blox_snap *out);
+double blox_mono(void);
+bool blox_algo_is_verus(void);         /* ccminer.cpp: opt_algo is the Verus slot */
+void blox_install_signals(bool background);
+
+/* ---- terminal + log (blox_ui.cpp) ---- */
+extern FILE *blox_log_fp;              /* plain-text log (--log-file), NULL when off */
+extern bool blox_dash_active;
+void blox_log_open(const char *path);
+void blox_log_line_locked(const char *line);   /* caller holds applog_lock */
+void blox_banner(void);
+void blox_ui_init(void);
+void blox_ui_tick(const struct blox_snap *s, bool full_redraw, bool resized);
+void blox_ui_periodic(const struct blox_snap *s);
+void blox_ui_restore(void);            /* normal context only (proper_exit) */
diff -ruN a/blox_stats.cpp b/blox_stats.cpp
--- a/blox_stats.cpp	1970-01-01 03:00:00
+++ b/blox_stats.cpp	2026-09-27 14:18:57
@@ -0,0 +1,232 @@
+/* BloxMiner service thread: per-core snapshot every 2 s, dashboard redraw, periodic table, signal watcher.
+ * Signal handlers only set flags and write one byte to a pipe; all real work happens in this thread. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <pthread.h>
+#include <signal.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "miner.h"
+#include "blox.h"
+
+extern double thr_ratek[];
+extern time_t thr_lastwork[];
+extern double thr_maxdur[];
+extern int thr_cpu[];
+extern time_t hcv_mono_now(void);
+extern pthread_mutex_t stats_lock;
+
+int blox_ccd_opt = -1;
+int blox_stats_interval = 60;
+bool blox_no_dashboard = false;
+bool blox_thread_log = false;
+struct blox_topo blox_topology;
+
+static struct blox_rapl rapl;
+static struct blox_snap snap;
+static pthread_mutex_t snap_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_t blox_pth;
+static time_t blox_started;
+static int wake_pipe[2] = { -1, -1 };
+static volatile sig_atomic_t sig_term = 0, sig_winch = 0;
+
+double blox_mono(void)
+{
+	struct timespec t;
+	clock_gettime(CLOCK_MONOTONIC, &t);
+	return t.tv_sec + t.tv_nsec / 1e9;
+}
+
+static void on_signal(int sig)
+{
+	int saved = errno;
+	if (sig == SIGWINCH) sig_winch = 1;
+	else if (sig == SIGINT || sig == SIGTERM) {
+		if (sig_term) _exit(EXIT_CODE_KILLED);   /* second signal: leave now, no output (it could block) */
+		sig_term = sig;
+	}
+	/* SIGHUP (background mode only): keep running, as upstream did */
+	if (wake_pipe[1] >= 0) { char c = 1; ssize_t w = write(wake_pipe[1], &c, 1); (void) w; }
+	errno = saved;
+}
+
+void blox_install_signals(bool background)
+{
+	struct sigaction sa;
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_handler = on_signal;
+	sigemptyset(&sa.sa_mask);
+	sa.sa_flags = SA_RESTART;
+	sigaction(SIGINT, &sa, NULL);
+	sigaction(SIGTERM, &sa, NULL);
+	sigaction(SIGWINCH, &sa, NULL);
+	/* Foreground: SIGHUP keeps its default action. HiveOS stops a miner by closing its screen window,
+	 * which sends SIGHUP; handling it would leave an orphan miner running. */
+	if (background) sigaction(SIGHUP, &sa, NULL);
+}
+
+static int cmp_row(const void *a, const void *b)
+{
+	const struct blox_row *x = (const struct blox_row *) a, *y = (const struct blox_row *) b;
+	if (x->pkg != y->pkg) return x->pkg < y->pkg ? -1 : 1;
+	if (x->core != y->core) return x->core < y->core ? -1 : 1;
+	return 0;
+}
+
+static void sample(void)
+{
+	static struct blox_snap s;            /* only this thread writes it */
+	double ratek[BLOX_MAX_ROWS], maxdur[BLOX_MAX_ROWS];
+	time_t lastwork[BLOX_MAX_ROWS];
+	int cpu[BLOX_MAX_ROWS];
+	int n = opt_n_threads;
+	if (n > BLOX_MAX_ROWS) n = BLOX_MAX_ROWS;
+
+	pthread_mutex_lock(&stats_lock);      /* copy, then release before any I/O */
+	for (int i = 0; i < n; i++) { ratek[i] = thr_ratek[i]; maxdur[i] = thr_maxdur[i]; lastwork[i] = thr_lastwork[i]; cpu[i] = thr_cpu[i]; }
+	pthread_mutex_unlock(&stats_lock);
+
+	uint64_t gen = s.gen;
+	memset(&s, 0, sizeof(s));
+	s.gen = gen + 1;
+	s.threads_cfg = n;
+	time_t mono = hcv_mono_now();
+	double uptime = difftime(time(NULL), blox_started);
+	double khs[BLOX_MAX_ROWS];
+	bool started[BLOX_MAX_ROWS];
+	int overdue = 0;
+	for (int i = 0; i < n; i++) {         /* same freshness rule as the API `threads`/`summary` */
+		long age = lastwork[i] ? (long) difftime(mono, lastwork[i]) : -1;
+		bool late = age < 0 ? uptime > 600 : age > blox_stale_limit(maxdur[i]);
+		if (late) overdue++;
+		started[i] = lastwork[i] != 0 || late;
+		khs[i] = !late && age >= 0 ? ratek[i] / 1000.0 : 0.0;
+		s.fresh_khs += khs[i];
+	}
+	s.stall = n > 0 && overdue == n;
+
+	const struct blox_topo *t = &blox_topology;
+	bool percore = n > 0;
+	for (int i = 0; i < n && percore; i++)
+		percore = cpu[i] >= 0 && cpu[i] < t->ncpu && t->cpu[cpu[i]].present;
+	s.percore = percore;
+	for (int i = 0; i < n; i++) {
+		struct blox_row *r = NULL;
+		if (percore) {
+			int pk = t->cpu[cpu[i]].pkg, co = t->cpu[cpu[i]].core;
+			for (int k = 0; k < s.rows && !r; k++) if (s.row[k].pkg == pk && s.row[k].core == co) r = &s.row[k];
+			if (!r) { r = &s.row[s.rows++]; r->pkg = pk; r->core = co; r->pending = true; }
+		} else {
+			r = &s.row[s.rows++]; r->pkg = r->core = -1; r->pending = true;
+		}
+		if (started[i]) r->pending = false;
+		if (r->ncpu < BLOX_ROW_CPUS) r->cpus[r->ncpu++] = percore ? cpu[i] : (cpu[i] >= 0 ? cpu[i] : -1);
+		r->khs += khs[i];
+		s.threads_covered++;
+	}
+	if (percore) qsort(s.row, s.rows, sizeof(s.row[0]), cmp_row);
+	for (int k = 0; k < s.rows; k++) {
+		int src = BLOX_T_NONE;
+		s.row[k].temp = s.row[k].ncpu && s.row[k].cpus[0] >= 0 ? blox_cpu_temp(t, s.row[k].cpus[0], &src) : blox_pkg_temp(t);
+		if (!(s.row[k].ncpu && s.row[k].cpus[0] >= 0) && s.row[k].temp >= 0) src = BLOX_T_PKG;
+		s.row[k].temp_src = src;
+	}
+	s.pkg_temp = blox_pkg_temp(t);
+	s.power_w = blox_rapl_watts(&rapl, blox_mono());
+	s.mono = blox_mono();
+
+	pthread_mutex_lock(&snap_lock);
+	snap = s;
+	pthread_mutex_unlock(&snap_lock);
+}
+
+bool blox_snapshot(struct blox_snap *out)
+{
+	pthread_mutex_lock(&snap_lock);
+	*out = snap;
+	pthread_mutex_unlock(&snap_lock);
+	return out->gen > 0;
+}
+
+static void *exit_thread(void *arg)
+{
+	(void) arg;
+	applog(LOG_INFO, "%s received, exiting", sig_term == SIGINT ? "SIGINT" : "SIGTERM");
+	proper_exit(EXIT_CODE_KILLED);           /* restores the terminal (best effort), then exit() */
+	return NULL;
+}
+
+/* Watches only for SIGINT/SIGTERM, so a blocked terminal, pipe or log write elsewhere can never stop the
+ * miner from exiting: the exit runs in its own thread and is forced after 5 s if it has not finished. */
+static void *sigwatch_thread(void *arg)
+{
+	(void) arg;
+	while (!sig_term) usleep(100 * 1000);
+	pthread_t t;
+	if (pthread_create(&t, NULL, exit_thread, NULL) == 0) pthread_detach(t);
+	sleep(5);
+	_exit(EXIT_CODE_KILLED);
+	return NULL;
+}
+
+static void *blox_thread(void *arg)
+{
+	(void) arg;
+	static struct blox_snap s;
+	double next_sample = 0, next_full = 0, next_table = blox_mono() + blox_stats_interval;
+	while (!abort_flag) {
+		struct pollfd pfd;
+		pfd.fd = wake_pipe[0]; pfd.events = POLLIN; pfd.revents = 0;
+		poll(&pfd, 1, 250);
+		if (pfd.revents & POLLIN) { char b[64]; while (read(wake_pipe[0], b, sizeof(b)) > 0) {} }
+		if (sig_term) break;                    /* the signal watcher owns the exit */
+		bool resized = sig_winch != 0;
+		sig_winch = 0;
+		double now = blox_mono();
+		if (now >= next_sample) { sample(); next_sample = now + 2.0; }
+		/* the UI redraws after each new sample, on resize, and fully every 10 s (screen detach/reattach) */
+		bool full = resized || now >= next_full;
+		if (full) next_full = now + 10.0;
+		blox_snapshot(&s);
+		blox_ui_tick(&s, full, resized);
+		if (blox_stats_interval > 0 && now >= next_table) {
+			blox_ui_periodic(&s);
+			next_table = now + blox_stats_interval;
+		}
+	}
+	return NULL;
+}
+
+void blox_prepare(void)                 /* topology + power sources, before the UI is set up */
+{
+	blox_started = time(NULL);
+	blox_topo_init(&blox_topology, blox_ccd_opt);
+	blox_rapl_init(&rapl, &blox_topology);
+}
+
+bool blox_start(void)
+{
+	if (pipe(wake_pipe) == 0) {
+		for (int i = 0; i < 2; i++) {
+			fcntl(wake_pipe[i], F_SETFL, fcntl(wake_pipe[i], F_GETFL) | O_NONBLOCK);
+			fcntl(wake_pipe[i], F_SETFD, FD_CLOEXEC);
+		}
+	} else wake_pipe[0] = wake_pipe[1] = -1;
+	pthread_t w;
+	if (pthread_create(&w, NULL, sigwatch_thread, NULL)) {
+		applog(LOG_ERR, "signal watch thread create failed");
+		return false;
+	}
+	pthread_detach(w);
+	if (pthread_create(&blox_pth, NULL, blox_thread, NULL)) {
+		applog(LOG_ERR, "stats thread create failed");
+		return false;
+	}
+	pthread_detach(blox_pth);
+	return true;
+}
diff -ruN a/blox_sys.cpp b/blox_sys.cpp
--- a/blox_sys.cpp	1970-01-01 03:00:00
+++ b/blox_sys.cpp	2026-09-27 14:48:46
@@ -0,0 +1,357 @@
+/* BloxMiner: CPU topology, temperature sources and RAPL package power from sysfs.
+ * Everything is read-only sysfs/procfs; $BLOX_SYSFS_ROOT prefixes every path (unit tests use fake trees). */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <limits.h>
+#include <unistd.h>
+#include <time.h>
+
+#include "blox.h"
+
+const char *blox_sysfs(const char *path, char *out, size_t outsz)
+{
+	const char *root = getenv("BLOX_SYSFS_ROOT");
+	snprintf(out, outsz, "%s%s", root ? root : "", path);
+	return out;
+}
+
+static bool read_str(const char *abs, char *buf, size_t sz)
+{
+	FILE *f = fopen(abs, "r");
+	if (!f) return false;
+	bool ok = fgets(buf, (int) sz, f) != NULL;
+	fclose(f);
+	if (!ok) return false;
+	buf[strcspn(buf, "\r\n")] = '\0';
+	return true;
+}
+
+static bool read_ll(const char *abs, long long *v)
+{
+	char b[64], *end;
+	if (!read_str(abs, b, sizeof(b))) return false;
+	*v = strtoll(b, &end, 10);
+	return end != b;
+}
+
+static bool sys_ll(const char *rel, long long *v)
+{
+	char p[PATH_MAX];
+	return read_ll(blox_sysfs(rel, p, sizeof(p)), v);
+}
+
+int blox_read_temp(const char *path)
+{
+	long long v;
+	if (!path || !*path || !read_ll(path, &v)) return -1;
+	if (v < -40000 || v > 150000) return -1;          /* millidegrees; implausible => unavailable */
+	return (int) ((v + (v >= 0 ? 500 : -500)) / 1000);
+}
+
+static int pkg_index(const struct blox_topo *t, int pkg)
+{
+	for (int i = 0; i < t->npkg; i++) if (t->pkg_id[i] == pkg) return i;
+	return -1;
+}
+
+/* Validated per-CCD temperature profiles: (family, model, #L3, #Tccd). Each entry was confirmed with a
+ * controlled load pinned to one CCD at a time (only that CCD's Tccd rose). Add entries only that way. */
+static const struct { int family, model, nl3, ntccd; const char *what; } ccd_profiles[] = {
+	{ 25, 33, 1, 1, "Ryzen 5000 (Vermeer), 1 CCD" },
+	{ 25, 33, 2, 2, "Ryzen 5000 (Vermeer), 2 CCD" },   /* 5950X load test 2026-09-26 */
+};
+
+static void cpuinfo(struct blox_topo *t)
+{
+	char p[PATH_MAX], line[256];
+	FILE *f = fopen(blox_sysfs("/proc/cpuinfo", p, sizeof(p)), "r");
+	t->family = t->model = -1;
+	if (!f) return;
+	while (fgets(line, sizeof(line), f)) {
+		char *v = strchr(line, ':');
+		if (!v) continue;
+		v++; while (*v == ' ' || *v == '\t') v++;
+		v[strcspn(v, "\r\n")] = '\0';
+		if (!strncmp(line, "vendor_id", 9) && !t->vendor[0]) snprintf(t->vendor, sizeof(t->vendor), "%s", v);
+		else if (!strncmp(line, "cpu family", 10) && t->family < 0) t->family = atoi(v);
+		else if (!strncmp(line, "model name", 10) && !t->model_name[0]) snprintf(t->model_name, sizeof(t->model_name), "%s", v);
+		else if (!strncmp(line, "model", 5) && (line[5] == '\t' || line[5] == ' ' || line[5] == ':') && t->model < 0) t->model = atoi(v);
+	}
+	fclose(f);
+}
+
+/* L3 cache id of a cpu: the cache index whose level is 3 */
+static int l3_id(int cpu)
+{
+	char rel[128]; long long lvl, id;
+	for (int i = 0; i < 10; i++) {
+		snprintf(rel, sizeof(rel), "/sys/devices/system/cpu/cpu%d/cache/index%d/level", cpu, i);
+		if (!sys_ll(rel, &lvl)) continue;
+		if (lvl != 3) continue;
+		snprintf(rel, sizeof(rel), "/sys/devices/system/cpu/cpu%d/cache/index%d/id", cpu, i);
+		if (sys_ll(rel, &id)) return (int) id;
+	}
+	return -1;
+}
+
+/* Package of an AMD k10temp sensor: every CPU in its PCI device's local_cpulist ("0-3,8-11") must belong to
+ * one and the same package. -1 when that cannot be established: the temperature is then unavailable. */
+static int k10temp_pkg(const char *hwmon)
+{
+	char p[PATH_MAX], list[1024], rel[128];
+	snprintf(p, sizeof(p), "%s/device/local_cpulist", hwmon);
+	if (!read_str(p, list, sizeof(list))) return -1;
+	int pkg = -1, n = 0;
+	for (char *tok = list; *tok; ) {
+		char *end; long a = strtol(tok, &end, 10), b = a;
+		if (end == tok || a < 0) return -1;
+		if (*end == '-') { tok = end + 1; b = strtol(tok, &end, 10); if (end == tok || b < a) return -1; }
+		if (b >= BLOX_MAX_CPUS) return -1;
+		for (long c = a; c <= b; c++) {
+			long long pk;
+			snprintf(rel, sizeof(rel), "/sys/devices/system/cpu/cpu%ld/topology/physical_package_id", c);
+			if (!sys_ll(rel, &pk)) continue;                       /* offline CPU */
+			if (pkg >= 0 && pk != pkg) return -1;                 /* spans packages: ambiguous */
+			pkg = (int) pk; n++;
+		}
+		if (*end == ',') tok = end + 1;
+		else if (*end == '\0') break;
+		else return -1;
+	}
+	return n ? pkg : -1;
+}
+
+static bool find_label(const char *hwmon, const char *want, char *input, size_t sz)
+{
+	char p[PATH_MAX], lab[64];
+	for (int i = 1; i < 64; i++) {
+		snprintf(p, sizeof(p), "%s/temp%d_label", hwmon, i);
+		if (!read_str(p, lab, sizeof(lab))) continue;
+		if (!strcmp(lab, want)) { snprintf(input, sz, "%s/temp%d_input", hwmon, i); return true; }
+	}
+	return false;
+}
+
+static int count_tccd(const char *hwmon)
+{
+	char p[PATH_MAX], lab[64]; int n = 0;
+	for (int i = 1; i < 64; i++) {
+		snprintf(p, sizeof(p), "%s/temp%d_label", hwmon, i);
+		if (read_str(p, lab, sizeof(lab)) && !strncmp(lab, "Tccd", 4)) n++;
+	}
+	return n;
+}
+
+void blox_topo_init(struct blox_topo *t, int ccd_opt)
+{
+	char p[PATH_MAX], rel[160], name[64];
+	memset(t, 0, sizeof(*t));
+	cpuinfo(t);
+
+	/* ---- cpus */
+	for (int c = 0; c < BLOX_MAX_CPUS; c++) {
+		long long pkg, core;
+		struct blox_cpu *u = &t->cpu[c];
+		u->pkg = u->core = u->l3 = -1;
+		snprintf(rel, sizeof(rel), "/sys/devices/system/cpu/cpu%d/topology/physical_package_id", c);
+		if (!sys_ll(rel, &pkg)) continue;
+		snprintf(rel, sizeof(rel), "/sys/devices/system/cpu/cpu%d/topology/core_id", c);
+		if (!sys_ll(rel, &core)) continue;
+		u->present = true; u->pkg = (int) pkg; u->core = (int) core; u->l3 = l3_id(c);
+		t->ncpu = c + 1; t->threads++;
+		if (pkg_index(t, u->pkg) < 0 && t->npkg < BLOX_MAX_PKGS) t->pkg_id[t->npkg++] = u->pkg;
+	}
+	for (int c = 0; c < t->ncpu; c++) {       /* physical cores = unique (pkg, core) */
+		if (!t->cpu[c].present) continue;
+		bool seen = false;
+		for (int d = 0; d < c && !seen; d++)
+			seen = t->cpu[d].present && t->cpu[d].pkg == t->cpu[c].pkg && t->cpu[d].core == t->cpu[c].core;
+		if (!seen) t->cores++;
+	}
+	int l3s[BLOX_MAX_CPUS], nl3 = 0;          /* sorted unique L3 ids */
+	for (int c = 0; c < t->ncpu; c++) {
+		int id = t->cpu[c].l3; bool dup = false;
+		if (!t->cpu[c].present || id < 0) continue;
+		for (int i = 0; i < nl3 && !dup; i++) dup = l3s[i] == id;
+		if (!dup) l3s[nl3++] = id;
+	}
+	for (int i = 1; i < nl3; i++) for (int j = i; j > 0 && l3s[j - 1] > l3s[j]; j--) { int x = l3s[j]; l3s[j] = l3s[j - 1]; l3s[j - 1] = x; }
+	t->nl3 = nl3;
+
+	/* ---- hwmon: package temps, Intel per-core, AMD per-CCD */
+	char k10[BLOX_MAX_PKGS][PATH_MAX]; int nk10 = 0;
+	for (int h = 0; h < 64; h++) {
+		char hw[PATH_MAX];
+		snprintf(rel, sizeof(rel), "/sys/class/hwmon/hwmon%d", h);
+		blox_sysfs(rel, hw, sizeof(hw));
+		snprintf(p, sizeof(p), "%s/name", hw);
+		if (!read_str(p, name, sizeof(name))) continue;
+		if (!strcmp(name, "k10temp") && nk10 < BLOX_MAX_PKGS) {
+			snprintf(k10[nk10++], PATH_MAX, "%s", hw);
+		} else if (!strcmp(name, "coretemp")) {
+			char lab[64]; long long pk;
+			snprintf(p, sizeof(p), "%s/temp1_label", hw);
+			if (!read_str(p, lab, sizeof(lab)) || sscanf(lab, "Package id %lld", &pk) != 1) continue;
+			int pi = pkg_index(t, (int) pk);
+			if (pi < 0) continue;
+			snprintf(t->pkg_temp_path[pi], sizeof(t->pkg_temp_path[pi]), "%s/temp1_input", hw);
+			for (int c = 0; c < t->ncpu; c++) {
+				struct blox_cpu *u = &t->cpu[c];
+				char want[32], in[160];
+				if (!u->present || u->pkg != (int) pk) continue;
+				snprintf(want, sizeof(want), "Core %d", u->core);
+				if (find_label(hw, want, in, sizeof(in))) { snprintf(u->temp_path, sizeof(u->temp_path), "%s", in); u->temp_src = BLOX_T_CORE; }
+			}
+		}
+	}
+	for (int k = 0; k < nk10; k++) {            /* AMD package temp per socket: Tctl, else Tdie */
+		int pkg = nk10 == 1 && t->npkg == 1 ? t->pkg_id[0] : k10temp_pkg(k10[k]);
+		int pi = pkg >= 0 ? pkg_index(t, pkg) : -1;
+		if (pi < 0) continue;
+		if (!find_label(k10[k], "Tctl", t->pkg_temp_path[pi], sizeof(t->pkg_temp_path[pi])))
+			find_label(k10[k], "Tdie", t->pkg_temp_path[pi], sizeof(t->pkg_temp_path[pi]));
+	}
+
+	/* ---- per-CCD decision (AMD) */
+	t->ntccd = nk10 == 1 ? count_tccd(k10[0]) : 0;
+	const char *why = NULL; char buf[128];
+	if (nk10 == 0)                      why = "no AMD k10temp sensor";
+	else if (ccd_opt == 0)              why = "off (ccd-temp-map=0)";
+	else if (t->npkg > 1 || nk10 > 1)   why = "multi-socket: package temperature per socket";
+	else if (t->ntccd == 0)             why = "no Tccd sensors (Tctl only)";
+	else if (t->nl3 == 0)               why = "no L3 topology in sysfs";
+	else if (t->nl3 % t->ntccd)         why = "L3 count is not a multiple of the Tccd count";
+	if (!why && ccd_opt < 0) {
+		const char *prof = NULL;
+		for (size_t i = 0; i < sizeof(ccd_profiles) / sizeof(ccd_profiles[0]); i++)
+			if (ccd_profiles[i].family == t->family && ccd_profiles[i].model == t->model &&
+			    ccd_profiles[i].nl3 == t->nl3 && ccd_profiles[i].ntccd == t->ntccd) prof = ccd_profiles[i].what;
+		if (prof) { snprintf(buf, sizeof(buf), "validated profile: %s", prof); t->ccd_mode = 1; }
+		else {
+			snprintf(buf, sizeof(buf), "no validated profile for family %d model %d (L3 %d, Tccd %d); ccd-temp-map=1 forces it",
+				t->family, t->model, t->nl3, t->ntccd);
+			why = buf;
+		}
+	} else if (!why) {
+		snprintf(buf, sizeof(buf), "forced (ccd-temp-map=1): heuristic L3 order -> Tccd order, %d L3 per CCD", t->nl3 / t->ntccd);
+		t->ccd_mode = 1;
+	}
+	snprintf(t->ccd_reason, sizeof(t->ccd_reason), "%s", why ? why : buf);
+	if (t->ccd_mode) {
+		int ratio = t->nl3 / t->ntccd;
+		for (int c = 0; c < t->ncpu; c++) {
+			struct blox_cpu *u = &t->cpu[c]; int r = -1; char want[16], in[160];
+			if (!u->present || u->l3 < 0) continue;
+			for (int i = 0; i < nl3; i++) if (l3s[i] == u->l3) r = i;
+			if (r < 0) continue;
+			snprintf(want, sizeof(want), "Tccd%d", r / ratio + 1);
+			if (find_label(k10[0], want, in, sizeof(in))) { snprintf(u->temp_path, sizeof(u->temp_path), "%s", in); u->temp_src = BLOX_T_CCD; }
+		}
+	}
+}
+
+int blox_pkg_temp(const struct blox_topo *t)
+{
+	int best = -1;
+	for (int i = 0; i < t->npkg; i++) { int v = blox_read_temp(t->pkg_temp_path[i]); if (v > best) best = v; }
+	return best;
+}
+
+int blox_cpu_temp(const struct blox_topo *t, int cpu, int *src)
+{
+	int v = -1;
+	*src = BLOX_T_NONE;
+	if (cpu < 0 || cpu >= t->ncpu || !t->cpu[cpu].present) return -1;
+	if (t->cpu[cpu].temp_path[0] && (v = blox_read_temp(t->cpu[cpu].temp_path)) >= 0) { *src = t->cpu[cpu].temp_src; return v; }
+	int pi = pkg_index(t, t->cpu[cpu].pkg);
+	if (pi >= 0 && (v = blox_read_temp(t->pkg_temp_path[pi])) >= 0) { *src = BLOX_T_PKG; return v; }
+	return -1;
+}
+
+/* ---- RAPL: only top-level "package-N" domains (Intel "psys" would double count), one per topology package */
+void blox_rapl_init(struct blox_rapl *r, const struct blox_topo *t)
+{
+	char rel[64], dir[PATH_MAX], p[PATH_MAX], name[64];
+	int found[BLOX_MAX_PKGS] = { 0 };
+	memset(r, 0, sizeof(*r));
+	for (int d = 0; d < 32; d++) {
+		long long e, range; int pk;
+		snprintf(rel, sizeof(rel), "/sys/class/powercap/intel-rapl:%d", d);
+		blox_sysfs(rel, dir, sizeof(dir));
+		snprintf(p, sizeof(p), "%s/name", dir);
+		if (!read_str(p, name, sizeof(name)) || sscanf(name, "package-%d", &pk) != 1) continue;
+		int pi = pkg_index(t, pk);
+		if (pi < 0) { snprintf(r->reason, sizeof(r->reason), "RAPL %s has no matching CPU package", name); return; }
+		found[pi]++;
+		snprintf(p, sizeof(p), "%s/energy_uj", dir);
+		if (!read_ll(p, &e)) { snprintf(r->reason, sizeof(r->reason), "RAPL energy_uj not readable (needs root)"); return; }
+		snprintf(p, sizeof(p), "%s/max_energy_range_uj", dir);
+		if (!read_ll(p, &range) || range <= 0) { snprintf(r->reason, sizeof(r->reason), "RAPL max_energy_range_uj not readable"); return; }
+		if (r->n >= BLOX_MAX_PKGS) break;
+		snprintf(r->path[r->n], sizeof(r->path[r->n]), "%s/energy_uj", dir);
+		r->pkg[r->n] = pk; r->range[r->n] = (uint64_t) range; r->n++;
+	}
+	if (t->npkg == 0) { snprintf(r->reason, sizeof(r->reason), "no CPU topology"); return; }
+	for (int i = 0; i < t->npkg; i++)
+		if (found[i] != 1) {
+			snprintf(r->reason, sizeof(r->reason), found[i] ? "duplicate RAPL domain for package %d" : "no RAPL package domain for package %d", t->pkg_id[i]);
+			return;
+		}
+	r->usable = true;
+	snprintf(r->reason, sizeof(r->reason), "%d package domain%s", r->n, r->n > 1 ? "s" : "");
+}
+
+double blox_rapl_watts(struct blox_rapl *r, double now)
+{
+	if (!r->usable) return -1;
+	double total = 0; bool ok = true;
+	for (int i = 0; i < r->n; i++) {
+		long long e;
+		if (!read_ll(r->path[i], &e) || e < 0 || (uint64_t) e > r->range[i]) { r->have_last[i] = false; ok = false; continue; }
+		if (r->have_last[i]) {
+			/* one bound for both checks: at BLOX_RAPL_MAX_W the counter wraps once per maxdt seconds, so a
+			 * longer gap could hide a wrap, and a higher reading is not a CPU package */
+			double dt = now - r->last_t[i];
+			double maxdt = (double) r->range[i] / 1e6 / BLOX_RAPL_MAX_W;
+			double de = (double) e - (double) r->last_e[i];
+			if (de < 0) de += (double) r->range[i];
+			double w = dt > 0 ? de / 1e6 / dt : -1;
+			if (dt <= 0.5 || dt > maxdt || w <= 0 || w > BLOX_RAPL_MAX_W) ok = false;
+			else total += w;
+		} else ok = false;
+		r->last_e[i] = (uint64_t) e; r->last_t[i] = now; r->have_last[i] = true;
+	}
+	return ok ? total : -1;
+}
+
+void blox_sensors_dump(FILE *f, int ccd_opt)
+{
+	static struct blox_topo t;
+	struct blox_rapl r;
+	blox_topo_init(&t, ccd_opt);
+	fprintf(f, "CPU        %s | vendor %s family %d model %d\n", t.model_name[0] ? t.model_name : "?", t.vendor, t.family, t.model);
+	fprintf(f, "Topology   %d package(s), %d cores, %d threads, %d L3 group(s), %d Tccd sensor(s)\n",
+		t.npkg, t.cores, t.threads, t.nl3, t.ntccd);
+	fprintf(f, "Per-CCD    %s\n", t.ccd_reason);
+	for (int i = 0; i < t.npkg; i++)
+		fprintf(f, "Package %d  temp %d C  (%s)\n", t.pkg_id[i], blox_read_temp(t.pkg_temp_path[i]),
+			t.pkg_temp_path[i][0] ? t.pkg_temp_path[i] : "no sensor");
+	fprintf(f, "cpu pkg core  l3  src   temp  path\n");
+	for (int c = 0; c < t.ncpu; c++) {
+		const struct blox_cpu *u = &t.cpu[c]; int src;
+		if (!u->present) continue;
+		int v = blox_cpu_temp(&t, c, &src);
+		const char *s = src == BLOX_T_CCD ? "ccd" : src == BLOX_T_CORE ? "core" : src == BLOX_T_PKG ? "pkg" : "none";
+		fprintf(f, "%3d %3d %4d %3d  %-4s %4d  %s\n", c, u->pkg, u->core, u->l3, s, v, u->temp_path[0] ? u->temp_path : "-");
+	}
+	blox_rapl_init(&r, &t);
+	fprintf(f, "Power      %s\n", r.reason);
+	if (r.usable) {
+		struct timespec ts;
+		clock_gettime(CLOCK_MONOTONIC, &ts); blox_rapl_watts(&r, ts.tv_sec + ts.tv_nsec / 1e9);
+		sleep(1);
+		clock_gettime(CLOCK_MONOTONIC, &ts);
+		fprintf(f, "Power      %.0f W (1 s sample)\n", blox_rapl_watts(&r, ts.tv_sec + ts.tv_nsec / 1e9));
+	}
+}
diff -ruN a/blox_ui.cpp b/blox_ui.cpp
--- a/blox_ui.cpp	1970-01-01 03:00:00
+++ b/blox_ui.cpp	2026-09-27 14:21:47
@@ -0,0 +1,470 @@
+/* BloxMiner terminal output: banner with logo, sticky stats header (scroll region) on a TTY,
+ * periodic plain table otherwise, and a plain-text log file with size-based self-rotation.
+ * All terminal and log writes happen under applog_lock, from normal thread context. */
+#include <ccminer-config.h>
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <pthread.h>
+#include <string.h>
+#include <errno.h>
+#include <time.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+
+#include "miner.h"
+#include "blox.h"
+
+extern double stratum_diff;
+
+FILE *blox_log_fp = NULL;
+bool blox_dash_active = false;
+
+static char log_path[512];
+static long log_bytes;
+static const long LOG_MAX_BYTES = 10L * 1024 * 1024;   /* rotate to <file>.1 at 10 MB (no signals involved) */
+
+static bool tty, color, c256, dash_capable;   /* dash_capable: TTY, not dumb, dashboard allowed */
+static int term_rows, term_cols, hdr_h;
+static time_t ui_started;
+static uint64_t last_gen;
+static bool selftest_plain;   /* BLOX_UI_SELFTEST: print header rows as plain lines */
+
+/* palette */
+static const char *C_RST = "\033[0m";
+static const char *c_cell, *c_hot, *c_acc, *c_dim, *c_ok, *c_bad, *c_bold;
+
+static void pick_palette(void)
+{
+	if (c256) { c_cell = "\033[48;5;245m"; c_hot = "\033[48;5;214m"; c_acc = "\033[38;5;214m"; c_dim = "\033[38;5;245m"; c_ok = "\033[38;5;114m"; c_bad = "\033[38;5;203m"; }
+	else      { c_cell = "\033[100m";      c_hot = "\033[43m";       c_acc = "\033[33m";       c_dim = "\033[90m";       c_ok = "\033[32m";       c_bad = "\033[31m"; }
+	c_bold = "\033[1m";
+}
+
+/* ---------------------------------------------------------------- log file */
+
+static void strip_ansi(const char *in, char *out, size_t sz)
+{
+	size_t o = 0;
+	for (size_t i = 0; in[i] && o + 1 < sz; i++) {
+		if (in[i] == '\033' && in[i + 1] == '[') {
+			i += 2;
+			while (in[i] && !((in[i] >= '@' && in[i] <= '~'))) i++;
+			if (!in[i]) break;
+			continue;
+		}
+		out[o++] = in[i];
+	}
+	out[o] = '\0';
+}
+
+void blox_log_open(const char *path)
+{
+	if (!path || !*path) return;
+	snprintf(log_path, sizeof(log_path), "%s", path);
+	blox_log_fp = fopen(log_path, "a");
+	if (!blox_log_fp) {                     /* fail open: keep mining, keep the terminal output */
+		applog(LOG_WARNING, "log file %s: %s (continuing without a log file)", log_path, strerror(errno));
+		return;
+	}
+	setvbuf(blox_log_fp, NULL, _IOLBF, 0);
+	fseek(blox_log_fp, 0, SEEK_END);
+	log_bytes = ftell(blox_log_fp);
+}
+
+void blox_log_line_locked(const char *line)
+{
+	char plain[2048];
+	if (!blox_log_fp) return;
+	strip_ansi(line, plain, sizeof(plain));
+	size_t n = strlen(plain);
+	while (n && (plain[n - 1] == '\n' || plain[n - 1] == '\r')) plain[--n] = '\0';
+	fprintf(blox_log_fp, "%s\n", plain);
+	log_bytes += (long) n + 1;
+	if (log_bytes > LOG_MAX_BYTES) {
+		char old[600];
+		fclose(blox_log_fp);
+		snprintf(old, sizeof(old), "%s.1", log_path);
+		rename(log_path, old);
+		blox_log_fp = fopen(log_path, "a");
+		if (blox_log_fp) setvbuf(blox_log_fp, NULL, _IOLBF, 0);
+		log_bytes = 0;
+	}
+}
+
+/* ---------------------------------------------------------------- formatting helpers */
+
+struct line { char buf[2048]; size_t len; int vis; int max; };   /* max = visible-column budget */
+
+static void l_reset(struct line *l) { l->buf[0] = '\0'; l->len = 0; l->vis = 0; l->max = 1 << 20; }
+
+static int vis_len(const char *s)       /* printable columns of a UTF-8 string without escapes */
+{
+	int n = 0;
+	for (; *s; s++) {
+		if (*s == '\033') { while (*s && !(*s >= '@' && *s <= '~' && *s != '[')) s++; if (!*s) break; continue; }
+		if (((unsigned char) *s & 0xC0) != 0x80) n++;
+	}
+	return n;
+}
+
+static void l_add(struct line *l, const char *col, const char *fmt, ...)
+{
+	char tmp[512];
+	va_list ap;
+	va_start(ap, fmt);
+	vsnprintf(tmp, sizeof(tmp), fmt, ap);
+	va_end(ap);
+	int room = l->max - l->vis;                 /* clip to the budget: a row never wraps (text is ASCII) */
+	if (room <= 0) return;
+	if (vis_len(tmp) > room) tmp[room] = '\0';
+	int w = snprintf(l->buf + l->len, sizeof(l->buf) - l->len, "%s%s%s", color && col ? col : "", tmp, color && col ? C_RST : "");
+	if (w > 0 && (size_t) w < sizeof(l->buf) - l->len) { l->len += w; l->vis += vis_len(tmp); }
+}
+
+static void l_pad(struct line *l, int to) { while (l->vis < to) l_add(l, NULL, " "); }
+
+/* Degrees as a plain "C": GNU screen without UTF-8 mode counts a multi-byte degree sign as two
+ * columns, which breaks every row's width (seen in HiveOS-style screen sessions). */
+static const char *deg(void) { return "C"; }
+
+/* "AMD Ryzen 9 5900X 12-Core Processor" -> "Ryzen 9 5900X"; "Intel(R) Core(TM) i9-10900K CPU @ 3.70GHz" -> "i9-10900K" */
+static void short_model(const char *in, char *out, size_t sz)
+{
+	char buf[128], *tok, *save = NULL; size_t o = 0;
+	snprintf(buf, sizeof(buf), "%s", in);
+	char *at = strstr(buf, " @ "); if (at) *at = '\0';
+	out[0] = '\0';
+	for (tok = strtok_r(buf, " ", &save); tok; tok = strtok_r(NULL, " ", &save)) {
+		size_t n = strlen(tok);
+		if (!strcmp(tok, "AMD") || !strcmp(tok, "Intel(R)") || !strcmp(tok, "Core(TM)") || !strcmp(tok, "Processor") ||
+		    !strcmp(tok, "CPU") || (n > 5 && !strcmp(tok + n - 5, "-Core"))) continue;
+		o += snprintf(out + o, o < sz ? sz - o : 0, "%s%s", o ? " " : "", tok);
+		if (o >= sz) break;
+	}
+	if (!out[0]) snprintf(out, sz, "%s", in);
+}
+
+static void fmt_rate(char *o, size_t sz, double khs)
+{
+	if (khs >= 1e6)       snprintf(o, sz, "%.2f GH/s", khs / 1e6);
+	else if (khs >= 1e3)  snprintf(o, sz, "%.2f MH/s", khs / 1e3);
+	else                  snprintf(o, sz, "%.1f kH/s", khs);
+}
+
+static void fmt_cell_rate(char *o, size_t sz, double khs)
+{
+	if (khs >= 1e3) snprintf(o, sz, "%.2fM", khs / 1e3);
+	else            snprintf(o, sz, "%.0fK", khs);
+}
+
+static void fmt_up(char *o, size_t sz, long s)
+{
+	if (s >= 86400) snprintf(o, sz, "%ldd%02ldh", s / 86400, (s % 86400) / 3600);
+	else            snprintf(o, sz, "%ldh%02ldm", s / 3600, (s % 3600) / 60);
+}
+
+static void totals(unsigned *acc, unsigned *rej)
+{
+	*acc = *rej = 0;
+	for (int p = 0; p < num_pools; p++) { *acc += pools[p].accepted_count; *rej += pools[p].rejected_count; }
+}
+
+/* ---------------------------------------------------------------- banner */
+
+static const char *LOGO[5] = { "XXX.", "X..X", "XXA.", "X..X", "XXX." };   /* the "B" core grid, A = hot core */
+
+void blox_banner(void)
+{
+	const char *side[5] = { NULL, "VerusHash v2.2 CPU miner - GPL-3.0",
+		"based on ccminer (Christian Buchner, Christian H.) - Verus port by monkins1010",
+		"https://github.com/bokiko/bloxminer", "" };
+	char row[1024], plain[512];
+	pthread_mutex_lock(&applog_lock);
+	for (int r = 0; r < 5; r++) {
+		size_t o = 0, p = 0;
+		o += snprintf(row + o, sizeof(row) - o, " ");
+		p += snprintf(plain + p, sizeof(plain) - p, " ");
+		for (int c = 0; c < 4; c++) {
+			char ch = LOGO[r][c];
+			if (color) o += snprintf(row + o, sizeof(row) - o, "%s  %s", ch == '.' ? "" : ch == 'A' ? c_hot : c_cell, ch == '.' ? "" : C_RST);
+			else       o += snprintf(row + o, sizeof(row) - o, "%s", ch == '.' ? "  " : "##");
+			p += snprintf(plain + p, sizeof(plain) - p, "%s", ch == '.' ? "  " : "##");
+		}
+		if (r == 0) {
+			o += snprintf(row + o, sizeof(row) - o, "    %sBlox%s%sMiner%s %s", color ? c_bold : "", color ? C_RST : "",
+				color ? c_dim : "", color ? C_RST : "", PACKAGE_VERSION);
+			p += snprintf(plain + p, sizeof(plain) - p, "    BloxMiner %s", PACKAGE_VERSION);
+		} else {
+			o += snprintf(row + o, sizeof(row) - o, "    %s%s%s", color && r > 1 ? c_dim : "", side[r], color && r > 1 ? C_RST : "");
+			p += snprintf(plain + p, sizeof(plain) - p, "    %s", side[r]);
+		}
+		fprintf(stdout, "%s\n", row);
+		blox_log_line_locked(plain);
+	}
+	fprintf(stdout, "\n");
+	fflush(stdout);
+	pthread_mutex_unlock(&applog_lock);
+}
+
+/* ---------------------------------------------------------------- sticky header */
+
+static int grid_cols(int width) { int c = (width - 4) / 15; return c < 1 ? 1 : c; }
+
+static int expected_rows(void)          /* before the first sample: pinned threads ~ distinct cores */
+{
+	const struct blox_topo *t = &blox_topology;
+	int n = opt_n_threads, seen = 0;
+	if (!t->threads || n <= 0) return n > 0 ? n : 0;
+	int pk[BLOX_MAX_ROWS], co[BLOX_MAX_ROWS], used = 0;
+	for (int c = 0; c < t->ncpu && used < n; c++) {
+		if (!t->cpu[c].present) continue;
+		used++;
+		bool dup = false;
+		for (int i = 0; i < seen && !dup; i++) dup = pk[i] == t->cpu[c].pkg && co[i] == t->cpu[c].core;
+		if (!dup && seen < BLOX_MAX_ROWS) { pk[seen] = t->cpu[c].pkg; co[seen] = t->cpu[c].core; seen++; }
+	}
+	return used < n ? n : seen;
+}
+
+static int snap_rows(const struct blox_snap *s) { return s && s->gen ? s->rows : expected_rows(); }
+
+static int layout_height(int rows, int width, bool with_grid)
+{
+	int gl = with_grid && rows ? (rows + grid_cols(width) - 1) / grid_cols(width) : 0;
+	return 4 + (gl ? gl + 1 : 0) + 1;        /* border, title, stats x2, [sep + grid], border */
+}
+
+static int box_width(void) { int w = term_cols < 120 ? term_cols : 120; return w; }
+
+static void term_size(void)
+{
+	struct winsize ws;
+	if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0 && ws.ws_row && ws.ws_col) { term_rows = ws.ws_row; term_cols = ws.ws_col; }
+	else { term_rows = 24; term_cols = 80; }
+}
+
+static void hline(struct line *l, int w, char edge)
+{
+	l_reset(l);
+	char b[256]; int n = w - 2 < (int) sizeof(b) - 1 ? w - 2 : (int) sizeof(b) - 1;
+	memset(b, '-', n); b[n] = '\0';
+	l_add(l, c_dim, "%c%s%c", edge, b, edge);
+}
+
+static void close_row(struct line *l, int w) { l_pad(l, w - 1); l->max = w; l_add(l, c_dim, "|"); }
+
+static void draw_header_locked(const struct blox_snap *s)
+{
+	struct line l;
+	int w = box_width(), row = 1;
+	unsigned acc, rej;
+	char a[64], b[64], up[32];
+	totals(&acc, &rej);
+	fmt_up(up, sizeof(up), (long) difftime(time(NULL), ui_started));
+	bool with_grid = hdr_h > 5;   /* 5 = compact header */
+
+	if (!selftest_plain) fputs("\0337", stdout);   /* save cursor (it stays inside the scroll region) */
+#define EMIT() do { if (selftest_plain) fprintf(stdout, "%s\n", l.buf); \
+                    else fprintf(stdout, "\033[%d;1H\033[2K%s", row, l.buf); row++; } while (0)
+	hline(&l, w, '+'); EMIT();
+
+	l_reset(&l); l.max = w - 1; l_add(&l, c_dim, "| ");
+	l_add(&l, c_bold, "Blox"); l_add(&l, c_dim, "Miner"); l_add(&l, NULL, " %s", PACKAGE_VERSION);
+	char model[64];
+	short_model(blox_topology.model_name, model, sizeof(model));
+	int room = w - 2 - l.vis - (int) strlen(up) - 3 - 12;          /* keep "  nnC/nnT" and "up ..." */
+	if (blox_topology.model_name[0] && room > 6) l_add(&l, c_dim, "  %.*s", room, model);
+	l_add(&l, c_dim, "  %dC/%dT", blox_topology.cores, blox_topology.threads);
+	if (l.vis + 3 + (int) strlen(up) + 3 <= w - 1) { l_pad(&l, w - 3 - (int) strlen(up) - 3); l_add(&l, c_dim, "up %s", up); }
+	close_row(&l, w); EMIT();
+
+	l_reset(&l); l.max = w - 1; l_add(&l, c_dim, "| ");
+	if (!s || !s->gen) l_add(&l, c_dim, "starting...");
+	else if (s->stall) l_add(&l, c_bad, "STALLED: no recent work, 0 H/s");
+	else {
+		fmt_rate(a, sizeof(a), s->fresh_khs);
+		l_add(&l, NULL, "Hashrate "); l_add(&l, c_ok, "%s", a);
+	}
+	l_add(&l, NULL, "   A "); l_add(&l, c_ok, "%u", acc);
+	l_add(&l, NULL, "  R "); l_add(&l, rej ? c_acc : NULL, "%u", rej);
+	if (stratum_diff > 0) l_add(&l, NULL, "   Diff %.3g", stratum_diff);
+	close_row(&l, w); EMIT();
+
+	l_reset(&l); l.max = w - 1; l_add(&l, c_dim, "| ");
+	if (s && s->power_w >= 0) { l_add(&l, NULL, "Power "); l_add(&l, c_acc, "%.0f W", s->power_w); }
+	else l_add(&l, c_dim, "Power n/a");
+	if (s && s->pkg_temp >= 0) l_add(&l, NULL, "   Temp %d%s", s->pkg_temp, deg());
+	if (s && s->power_w > 0 && s->fresh_khs > 0 && !s->stall) l_add(&l, NULL, "   Eff %.0f kH/W", s->fresh_khs / s->power_w);
+	int prem = w - 2 - l.vis - 8;                                  /* what fits before the right border */
+	if (num_pools > 0 && pools[cur_pooln].short_url[0] && prem >= 12) {
+		const char *u = pools[cur_pooln].short_url;
+		int ul = (int) strlen(u);
+		l_add(&l, NULL, "   Pool ");
+		if (ul <= prem) l_add(&l, c_dim, "%s", u);
+		else l_add(&l, c_dim, "%.*s~", prem - 1, u);
+	}
+	close_row(&l, w); EMIT();
+
+	if (with_grid && s && s->rows) {
+		hline(&l, w, '+'); EMIT();
+		int cols = grid_cols(w);
+		for (int k = 0; k < s->rows; k += cols) {
+			l_reset(&l); l.max = w - 1; l_add(&l, c_dim, "| ");
+			for (int j = k; j < k + cols && j < s->rows; j++) {
+				const struct blox_row *r = &s->row[j];
+				fmt_cell_rate(b, sizeof(b), r->khs);
+				l_add(&l, c_dim, "%s%02d ", s->percore ? "C" : "T", j);
+				if (r->pending) l_add(&l, c_dim, "%-6s", "...");
+				else l_add(&l, r->khs > 0 ? NULL : c_bad, "%-6s", b);
+				if (r->temp >= 0) l_add(&l, r->temp >= 90 ? c_bad : NULL, "%3d%s ", r->temp, deg());
+				else l_add(&l, c_dim, "  -- ");
+				l_pad(&l, 2 + (j - k + 1) * 15);
+			}
+			close_row(&l, w); EMIT();
+		}
+	}
+	hline(&l, w, '+'); EMIT();
+#undef EMIT
+	if (!selftest_plain) fputs("\0338", stdout);   /* restore cursor */
+	fflush(stdout);
+}
+
+/* clear: wipe the screen first (first setup and resize); otherwise keep the log lines on screen */
+static void setup_region_locked(const struct blox_snap *s, bool clear)
+{
+	term_size();
+	int w = box_width(), rows = snap_rows(s);
+	hdr_h = layout_height(rows, w, true);
+	if (term_rows < hdr_h + 5) hdr_h = layout_height(rows, w, false);  /* compact: no core grid */
+	if (term_rows < hdr_h + 5 || w < 60) {                               /* too small: plain scrolling output */
+		if (blox_dash_active) fprintf(stdout, "\033[r\033[%d;1H", term_rows);
+		blox_dash_active = false;
+		fflush(stdout);
+		return;
+	}
+	fprintf(stdout, "\033[r");                                  /* reset any stale region */
+	if (clear) fprintf(stdout, "\033[2J");
+	fprintf(stdout, "\033[%d;%dr", hdr_h + 1, term_rows);      /* logs scroll below the header */
+	fprintf(stdout, "\033[%d;1H", term_rows);                  /* cursor at the bottom of the region */
+	blox_dash_active = true;
+	draw_header_locked(s);
+}
+
+/* Test hook: BLOX_UI_SELFTEST=<columns> renders the header for worst-case states as plain lines and exits,
+ * so tests can check that no row is wider than the terminal. */
+static void ui_selftest(int cols)
+{
+	static struct blox_snap st;
+	selftest_plain = true; color = false; tty = true;
+	term_cols = cols; term_rows = 200;
+	snprintf(blox_topology.model_name, sizeof(blox_topology.model_name), "%s",
+		"AMD Ryzen Threadripper PRO 7995WX 96-Cores Engineering Sample With A Very Long Name");
+	blox_topology.cores = 96; blox_topology.threads = 192;
+	num_pools = 1; cur_pooln = 0;
+	snprintf(pools[0].short_url, sizeof(pools[0].short_url), "%s", "stratum+tcp://an-extremely-long-pool-host-name.example.com:65535");
+	pools[0].accepted_count = 4294967295U; pools[0].rejected_count = 4294967295U;
+	stratum_diff = 1.23456789e300;
+	ui_started = time(NULL) - 10 * 86400 - 3600;
+	for (int state = 0; state < 4; state++) {
+		memset(&st, 0, sizeof(st));
+		st.gen = state == 3 ? 0 : 1; st.percore = true; st.rows = 64; st.threads_cfg = st.threads_covered = 128;
+		st.stall = state == 1; st.fresh_khs = 9.9e9; st.power_w = state == 2 ? -1 : 1234.5; st.pkg_temp = state == 2 ? -1 : 105;
+		for (int k = 0; k < st.rows; k++) {
+			st.row[k].khs = 99999.99; st.row[k].temp = state == 2 ? -1 : 105; st.row[k].pending = state == 2;
+		}
+		const char *name[] = { "huge counters", "stalled", "pending, no sensors", "starting" };
+		printf("## %s\n", name[state]);
+		hdr_h = layout_height(st.rows, box_width(), true);
+		draw_header_locked(&st);
+	}
+	exit(0);
+}
+
+void blox_ui_init(void)
+{
+	const char *self = getenv("BLOX_UI_SELFTEST");
+	if (self && atoi(self) > 0) ui_selftest(atoi(self));
+	const char *term = getenv("TERM");
+	tty = isatty(STDOUT_FILENO);
+	bool dumb = !term || !*term || !strcmp(term, "dumb");
+	color = tty && !dumb && use_colors && !getenv("NO_COLOR");
+	if (!color) use_colors = false;                             /* applog too: no escapes into pipes, TERM=dumb, NO_COLOR */
+	dash_capable = tty && !dumb && !blox_no_dashboard;
+	c256 = color && strstr(term, "256color");
+	pick_palette();
+	ui_started = time(NULL);
+	if (dash_capable) {
+		pthread_mutex_lock(&applog_lock);
+		setup_region_locked(NULL, true);
+		pthread_mutex_unlock(&applog_lock);
+	}
+	blox_banner();
+}
+
+void blox_ui_tick(const struct blox_snap *s, bool full, bool resized)
+{
+	if (!dash_capable) return;
+	pthread_mutex_lock(&applog_lock);
+	int want = layout_height(snap_rows(s), box_width(), true);
+	if (term_rows < want + 5) want = layout_height(snap_rows(s), box_width(), false);
+	if (resized) {
+		setup_region_locked(s, true);                           /* terminal size changed (or re-attached) */
+	} else if (blox_dash_active && want != hdr_h) {
+		setup_region_locked(s, false);                          /* grid size changed: keep the log lines */
+	} else if (blox_dash_active && (full || s->gen != last_gen)) {
+		draw_header_locked(s);
+	}
+	last_gen = s->gen;
+	pthread_mutex_unlock(&applog_lock);
+}
+
+void blox_ui_periodic(const struct blox_snap *s)
+{
+	char line[1024], a[64], b[64], up[32];
+	unsigned acc, rej;
+	if (!s->gen) return;
+	totals(&acc, &rej);
+	fmt_rate(a, sizeof(a), s->stall ? 0 : s->fresh_khs);
+	fmt_up(up, sizeof(up), (long) difftime(time(NULL), ui_started));
+	size_t o = snprintf(line, sizeof(line), "== BloxMiner %s | %s | A %u R %u", PACKAGE_VERSION, a, acc, rej);
+	if (s->power_w >= 0) o += snprintf(line + o, sizeof(line) - o, " | %.0f W", s->power_w);
+	if (s->pkg_temp >= 0) o += snprintf(line + o, sizeof(line) - o, " | %d C", s->pkg_temp);
+	if (s->power_w > 0 && s->fresh_khs > 0 && !s->stall) o += snprintf(line + o, sizeof(line) - o, " | %.0f kH/W", s->fresh_khs / s->power_w);
+	snprintf(line + o, sizeof(line) - o, " | up %s%s ==", up, s->stall ? " | STALLED" : "");
+
+	pthread_mutex_lock(&applog_lock);
+	if (!blox_dash_active) fprintf(stdout, "%s\n", line);
+	blox_log_line_locked(line);
+	for (int k = 0; k < s->rows; k += 6) {
+		size_t p = 0;
+		for (int j = k; j < k + 6 && j < s->rows; j++) {
+			if (s->row[j].pending) snprintf(b, sizeof(b), "...");
+			else fmt_cell_rate(b, sizeof(b), s->row[j].khs);
+			if (s->row[j].temp >= 0) p += snprintf(line + p, sizeof(line) - p, " %s%02d %-6s %3dC ", s->percore ? "C" : "T", j, b, s->row[j].temp);
+			else                     p += snprintf(line + p, sizeof(line) - p, " %s%02d %-6s  --  ", s->percore ? "C" : "T", j, b);
+		}
+		if (!blox_dash_active) fprintf(stdout, "%s\n", line);
+		blox_log_line_locked(line);
+	}
+	fflush(stdout);
+	pthread_mutex_unlock(&applog_lock);
+}
+
+void blox_ui_restore(void)
+{
+	/* best effort: never wait long for a log lock held by a writer that may be blocked */
+	int tries = 0;
+	while (pthread_mutex_trylock(&applog_lock) != 0) {
+		if (++tries > 20) return;                 /* ~1 s */
+		usleep(50 * 1000);
+	}
+	if (blox_dash_active) {
+		fprintf(stdout, "\033[r\033[%d;1H\033[0m\n", term_rows);
+		fflush(stdout);
+		blox_dash_active = false;
+	}
+	if (blox_log_fp) fflush(blox_log_fp);
+	pthread_mutex_unlock(&applog_lock);
+}
