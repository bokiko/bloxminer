diff --git a/src/version_blox.h b/src/version_blox.h
new file mode 100644
index 00000000..6a1a218d
--- /dev/null
+++ b/src/version_blox.h
@@ -0,0 +1,11 @@
+/* BloxMiner display-only branding for the RandomX (XMRig) engine.
+ * This constant is NEVER used for XMRig's own APP_VERSION, its user-agent string, or its API "version" field -
+ * those stay exactly "6.26.0" / "XMRig/6.26.0" for pool/API compatibility. It only labels two purely cosmetic
+ * log lines (the startup summary and the periodic hashrate line) with the BloxMiner PACKAGE release number.
+ */
+#ifndef XMRIG_VERSION_BLOX_H
+#define XMRIG_VERSION_BLOX_H
+
+#define BLOX_DISPLAY_VERSION "3.0.0"
+
+#endif /* XMRIG_VERSION_BLOX_H */
